3d_physics/layer_10="abyss"
3d_physics/layer_11="objetos pesados"
3d_physics/layer_12="dist_sensor"

[memory]

limits/message_queue/max_size_mb=64

[phantom_camera]

tips/show_jitter_tips=false

[physics]

3d/run_on_separate_thread=true
3d/physics_engine="Jolt Physics"
jolt_physics_3d/simulation/velocity_steps=3

[rendering]

occlusion_culling/bvh_build_quality=0
textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/compress_with_gpu=false
textures/vram_compression/cache_gpu_compressor=false
textures/lossless_compression/force_png=true
lights_and_shadows/directional_shadow/size=512
lights_and_shadows/directional_shadow/size.mobile=512
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=0
textures/default_filters/anisotropic_filtering_level=0
camera/depth_of_field/depth_of_field_bokeh_shape=0
camera/depth_of_field/depth_of_field_bokeh_quality=0
environment/ssao/quality=0
environment/ssao/half_size=false
environment/ssao/fadeout_from=11.9
environment/ssao/fadeout_to=64.0
environment/ssil/quality=0
environment/ssil/half_size=false
environment/ssil/fadeout_from=18.7
environment/ssil/fadeout_to=64.0
textures/decals/filter=0
textures/light_projectors/filter=0
occlusion_culling/occlusion_rays_per_thread=256
environment/glow/upscale_mode=0
environment/screen_space_reflection/roughness_quality=0
environment/subsurface_scattering/subsurface_scattering_quality=0
environment/volumetric_fog/use_filter=0
occlusion_culling/use_occlusion_culling=true
mesh_lod/lod_change/threshold_pixels=0.5
lights_and_shadows/positional_shadow/atlas_size.mobile=512
lights_and_shadows/positional_shadow/atlas_quadrant_0_subdiv=0
lights_and_shadows/positional_shadow/atlas_quadrant_1_subdiv=0
lights_and_shadows/positional_shadow/atlas_quadrant_2_subdiv=0
