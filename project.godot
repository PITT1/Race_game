; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Poly Race (4.5)"
config/description="Poly Race es un emocionante videojuego de carreras arcade con un estilo gráfico minimalista de pocos polígonos.
Compite en pistas llenas de adrenalina, demuestra tus habilidades al volante y gana dinero dentro del juego para desbloquear una gran variedad de autos.

✨ Características principales:

Diversión sin límites en diferentes pistas de carreras.

Sistema de recompensas para adquirir y coleccionar nuevos vehículos.

Estilo visual único con gráficos low-poly.

Actualizaciones constantes con más pistas, autos y modos de juego.

🎮 ¡La velocidad y la estrategia se combinan en Poly Race! ¿Estás listo para convertirte en el campeón y dominar cada circuito?"
run/main_scene="uid://ut6b48jgsc2u"
config/features=PackedStringArray("4.5", "Mobile")
run/max_fps=60
run/low_processor_mode=true
boot_splash/use_filter=false
boot_splash/image="uid://bcdal1ijwciut"
config/icon="uid://otdllthlxcbw"
boot_splash/minimum_display_time=1

[audio]

buses/default_bus_layout=""

[autoload]

PhantomCameraManager="*res://addons/phantom_camera/scripts/managers/phantom_camera_manager.gd"
GlobalVar="*res://global_var.gd"
BgMusicManager="*res://bg_music_manager.gd"
Ads="*res://ads.gd"
Options="*res://options.gd"

[display]

window/size/viewport_width=1612
window/size/viewport_height=720
window/stretch/mode="viewport"
window/stretch/aspect="ignore"
window/vsync/vsync_mode=0

[editor]

movie_writer/movie_file="D:/car_game/videos/game_play.avi"

[editor_plugins]

enabled=PackedStringArray("res://addons/admob/plugin.cfg", "res://addons/phantom_camera/plugin.cfg")

[gui]

theme/default_font_antialiasing=0
theme/custom="uid://csi40yx6vlfqs"
theme/custom_font="uid://cbwf465gr1onm"

